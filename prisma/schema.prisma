// Lista de símbolos para sync (cron) e cache-refresh. Fonte de verdade no banco.
model KlineSymbol {
  symbol          String   @id // ex: BTCUSDT
  ativo           Boolean  @default(true) // false = não sync/cache nem dropdown
  requiredDays1m  Int?     // janela 1m em dias (ex.: 9); null = default 9
  requiredDays5m  Int?     // janela 5m em dias (ex.: 90); null = default 90
  requiredDays1h  Int?     // janela 1h em dias (ex.: 730); null = default 730

  @@schema("backcrypto")
}

// Inscrições no programa de afiliados (landing /pt|en/afiliados).
model AffiliateApplication {
  id           String   @id @default(cuid())
  idAfiliado   String   @unique @map("id_afiliado")
  /// Brasil: 14 dígitos. Inscrições em EN podem usar só `taxId` (CNPJ nulo).
  cnpjDigits   String?  @map("cnpj_digits")
  /// Inscrições internacionais (EN): Tax ID / número de registo comercial.
  taxId        String?  @map("tax_id")
  razaoSocial  String   @map("razao_social")
  responsavel  String
  email        String   @unique
  siteUrl      String   @map("site_url")
  acceptedDocs Boolean  @default(false) @map("accepted_docs")
  approved     Boolean  @default(false) @map("aprovado")
  locale       String   @default("pt")
  /// Comissão fixa por venda plano anual (USD, centavos). Default 800 = US$ 8,00.
  commissionAnnualUsdCents  Int @default(800) @map("commission_annual_usd_cents")
  /// Comissão fixa por venda plano mensal (USD, centavos). Default 120 = US$ 1,20.
  commissionMonthlyUsdCents Int @default(120) @map("commission_monthly_usd_cents")
  createdAt    DateTime @default(now()) @map("created_at")

  payoutProfile AffiliatePayoutProfile?

  @@map("AffiliateApplication")
  @@schema("backcrypto")
}

/// Dados bancários / recebimento do afiliado (PIX ou conta BR; PayPal ou wire internacional).
model AffiliatePayoutProfile {
  id                     String   @id @default(cuid())
  affiliateApplicationId String   @unique @map("affiliate_application_id")
  affiliateApplication   AffiliateApplication @relation(fields: [affiliateApplicationId], references: [id], onDelete: Cascade)

  /// Última aba na UI: `br` | `intl`
  activeTab              String   @default("br") @map("active_tab") @db.VarChar(16)

  brRazaoSocial          String?  @map("br_razao_social") @db.VarChar(512)
  brCnpjDigits           String?  @map("br_cnpj_digits") @db.VarChar(14)
  brBanco                String?  @map("br_banco") @db.VarChar(256)
  /// `corrente` | `poupanca`
  brTipoConta            String?  @map("br_tipo_conta") @db.VarChar(32)
  brAgencia              String?  @map("br_agencia") @db.VarChar(32)
  brNumeroConta          String?  @map("br_numero_conta") @db.VarChar(64)
  brChavePix             String?  @map("br_chave_pix") @db.VarChar(512)

  /// `paypal` | `wire`
  intPaymentMethod       String?  @map("int_payment_method") @db.VarChar(16)
  intPaypalEmail         String?  @map("int_paypal_email") @db.VarChar(320)
  intBankName            String?  @map("int_bank_name") @db.VarChar(256)
  intAccountOrIban       String?  @map("int_account_or_iban") @db.VarChar(64)
  intSwiftBic            String?  @map("int_swift_bic") @db.VarChar(32)
  intAccountHolderName   String?  @map("int_account_holder_name") @db.VarChar(512)
  intCountry             String?  @map("int_country") @db.VarChar(120)

  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("AffiliatePayoutProfile")
  @@schema("backcrypto")
}
