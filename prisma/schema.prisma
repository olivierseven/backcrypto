// Cache de klines agregados: de 1m (1m,2m,3m,4m), de 5m (5m,15m,30m,45m), de 1h (1h–1d).
// Contém apenas dados com openTime < início do dia atual (UTC). Recriada pelo cron cache-refresh.
model BinanceKlineCache {
  symbol                   String
  interval                 String   // 1m | 2m | 3m | 4m | 5m | 15m | 30m | 45m | 1h | 2h | 4h | 6h | 8h | 12h | 1d
  /** Tipo de gráfico: interval (OHLC) | renko | range | kagi | renko2x | trades500 — padrão interval. */
  chartKind                String   @default("interval") @db.VarChar(32)
  openTime                 BigInt
  open                     Decimal  @db.Decimal(32, 8)
  high                     Decimal  @db.Decimal(32, 8)
  low                      Decimal  @db.Decimal(32, 8)
  close                    Decimal  @db.Decimal(32, 8)
  volume                   Decimal  @db.Decimal(32, 8)
  closeTime                BigInt
  quoteAssetVolume         Decimal  @db.Decimal(32, 8)
  numberOfTrades           Int
  takerBuyBaseAssetVolume  Decimal  @db.Decimal(32, 8)
  takerBuyQuoteAssetVolume Decimal  @db.Decimal(32, 8)

  @@id([symbol, interval, openTime])
  @@index([symbol, interval, openTime])
  @@index([symbol, interval, openTime(sort: Desc)], map: "BinanceKlineCache_symbol_interval_openTime_desc_idx")
  @@schema("backcrypto")
}

// Cache histórico para gráficos atemporais (Renko 1×, Range, Kagi, Renko 2×, velas por contagem de trades).
// Paralelo a `BinanceKlineCache` (só OHLC por intervalo). PK inclui `chartKind` para separar séries no mesmo símbolo.
// Preenchimento futuro (cron / job): copiar de Binance*Fast com openTime antes do início do dia UTC (mesma regra que o cache OHLC).
model BinanceKlineCache2 {
  symbol                   String
  chartKind                String   @db.VarChar(32) // renko | range | kagi | renko2x | trades500
  interval                 String   // ex.: 5ticks | 15ticks | 25ticks | … | 500trades
  openTime                 BigInt
  open                     Decimal  @db.Decimal(32, 8)
  high                     Decimal  @db.Decimal(32, 8)
  low                      Decimal  @db.Decimal(32, 8)
  close                    Decimal  @db.Decimal(32, 8)
  volume                   Decimal  @db.Decimal(32, 8)
  closeTime                BigInt
  quoteAssetVolume         Decimal  @db.Decimal(32, 8)
  numberOfTrades           Int
  takerBuyBaseAssetVolume  Decimal  @db.Decimal(32, 8)
  takerBuyQuoteAssetVolume Decimal  @db.Decimal(32, 8)

  @@id([symbol, chartKind, interval, openTime])
  @@index([symbol, chartKind, interval, openTime])
  @@index([symbol, chartKind, interval, openTime(sort: Desc)], map: "BinanceKlineCache2_symbol_chartKind_interval_openTime_desc_idx")
  @@schema("backcrypto")
}

