# Copie este arquivo para keystore.properties e preencha com seus valores.
# NÃO commite keystore.properties (já está no .gitignore).

# Caminho do arquivo .jks (relativo ao diretório android/app/)
# Nome correto deste app: cryptostrategy-release.jks (NÃO use nome legado tipo biogenerator-release.jks).
# Se ainda tiver o .jks antigo, renomeie o ficheiro para cryptostrategy-release.jks (é o mesmo keystore, só o nome).
# Ex.: android/app/cryptostrategy-release.jks
MYAPP_RELEASE_STORE_FILE=cryptostrategy-release.jks

# Senha do keystore (a mesma definida ao criar o .jks)
MYAPP_RELEASE_STORE_PASSWORD=sua_senha_aqui

# Alias da chave (o mesmo usado ao criar o keystore, ex: cryptostrategy)
MYAPP_RELEASE_KEY_ALIAS=cryptostrategy

# Senha da chave (geralmente igual à do keystore)
MYAPP_RELEASE_KEY_PASSWORD=sua_senha_aqui
