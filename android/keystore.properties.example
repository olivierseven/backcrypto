# Copie este arquivo para keystore.properties e preencha com seus valores.
# NÃO commite keystore.properties (já está no .gitignore).

# Caminho do arquivo .jks (relativo ao diretório android/app/)
# Se o .jks está em android/app/biogenerator-release.jks, use:
MYAPP_RELEASE_STORE_FILE=biogenerator-release.jks

# Senha do keystore (a mesma definida ao criar o .jks)
MYAPP_RELEASE_STORE_PASSWORD=sua_senha_aqui

# Alias da chave (o mesmo usado ao criar o keystore, ex: biogenerator)
MYAPP_RELEASE_KEY_ALIAS=biogenerator

# Senha da chave (geralmente igual à do keystore)
MYAPP_RELEASE_KEY_PASSWORD=sua_senha_aqui
