// Schema backcrypto — DATABASE_URL
generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/prisma-bio-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["backcrypto"]
}

enum Role {
  user
  admin

  @@schema("backcrypto")
}

enum AppLanguage {
  en
  pt

  @@schema("backcrypto")
}

enum Tier {
  free
  plus
  lite

  @@schema("backcrypto")
}

enum UserLevel {
  RECRUTA
  APRENDIZ
  EXPLORADOR
  JOGADOR
  AVANCADO
  ESPECIALISTA
  MESTRE
  ELITE
  LENDARIO
  SUPREMO
  MITICO
  CELESTIAL
  DIVINO

  @@schema("backcrypto")
}

enum TxType {
  CREDIT
  DEBIT
  ADJUSTMENT

  @@schema("backcrypto")
}

enum TxSource {
  STRIPE
  PAGARME
  SPEND
  REFUND
  ADMIN
  EXPIRATION
  BONUS
  PRIZE

  @@schema("backcrypto")
}

enum CheckoutStatus {
  CREATED
  COMPLETED
  REFUNDED
  CANCELED
  PARTIALLY_REFUNDED
  OVER_LIMIT

  @@schema("backcrypto")
}

model User {
  id                   String      @id @default(cuid())
  emailEnc             String
  emailIv              String
  emailTag             String
  emailSearchHash      String      @unique
  emailVerifiedAt      DateTime?
  name                 String?
  passwordHash         String
  specialCodeHash      String?
  specialExpiresAt     DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  role                 Role        @default(user)
  tier                 Tier        @default(free)
  nickname             String?     @unique
  nicknameChanges      Int         @default(0)
  avatarId             Int         @default(1)
  avatarBorder         String      @default("white")
  avatarSkinTone       Int?
  avatarColorTone      Int?
  sevenPoints          Int         @default(0)
  ganhoSimulado        Decimal     @default(0) @db.Decimal(65, 30)
  userLevel            UserLevel   @default(RECRUTA)
  position             Int?
  tmp                  Boolean     @default(false)
  isDeleted            Boolean     @default(false)
  dataExclusao         DateTime?
  dataExpiracao        DateTime?
  pushToken            String?
  pushTokenUpdated     DateTime?
  notifyMegaSena       Boolean     @default(true)
  notifyLotofacil      Boolean     @default(true)
  notifyQuina          Boolean     @default(true)
  hideStatusBar        Boolean     @default(true)
  progress             Int         @default(0)
  language             AppLanguage @default(en)
  timezoneOffset       Int         @default(0) // UTC offset in hours, -12 to +12
  activeTabId          String?     @map("active_tab_id") // Uma aba ativa por usuário (controle via banco)
  activeTabUpdatedAt   DateTime?   @map("active_tab_updated_at")
  previousTabId        String?     @map("previous_tab_id") // Aba que acabou de ser substituída (bloqueada por ~60s)
  previousTabUpdatedAt DateTime?   @map("previous_tab_updated_at")

  accessRequests      AccessRequest[]
  coinLedger          CoinLedgerEntry[]
  coinWallet          UserCoinWallet?
  checkoutSessions    StripeCheckoutSession[]
  pagarMeOrders       PagarMeOrder[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  EmailVerificationToken[]
  walletCredits       WalletCredit[]
  notifications       UserNotification[]
  chartLayouts        ChartLayout[]
  chartModels         ChartModel[]

  @@schema("backcrypto")
}

// Layouts do usuário (slots 1–7 apenas). Slot 0 não existe aqui; fica em ChartModels.
// Fonte da verdade: layout, indicators, strategies. (Coluna config foi removida do banco.)
model ChartLayout {
  userId     String   @map("user_id")
  slot       Int // 1–7 (Layout 1 … 7 por usuário)
  layout     Json? // config do gráfico (visibleCount, cores, VAP, etc.)
  indicators Json? // array userIndicators
  strategies Json? // { strategies: Strategy[], appliedStrategyIds: string[] }
  others     Json? // configs rápidas: visibleCount, chartStyle, candleBodyStyle, drawingsVisible, chartSizePercent, yPadOffset (não inclui draw-segments)
  name       String?  @db.VarChar(24) // Nome customizado (máx. 24 caracteres)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, slot])
  @@schema("backcrypto")
}

// Modelos de layout (ex.: Default, modelos personalizados). Mesmo esquema de 3 colunas que ChartLayout. (Coluna config foi removida do banco.)
model ChartModel {
  userId     String   @map("user_id")
  slot       Int
  layout     Json? // config do gráfico
  indicators Json? // array userIndicators
  strategies Json? // { strategies, appliedStrategyIds }
  others     Json? // configs rápidas: visibleCount, chartStyle, candleBodyStyle, drawingsVisible, chartSizePercent, yPadOffset (não inclui draw-segments)
  name       String?  @db.VarChar(24)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, slot])
  @@map("ChartModels")
  @@schema("backcrypto")
}

enum SenderType {
  system
  user

  @@schema("backcrypto")
}

model UserNotification {
  idNotification String     @id @default(cuid())
  senderType     SenderType
  sender         String?
  userId         String
  notification   String
  keySystem      String?
  ativo          Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  expiredDate    DateTime
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ativo])
  @@index([expiredDate])
  @@schema("backcrypto")
}

model AccessRequest {
  id        String   @id @default(cuid())
  userId    String
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@schema("backcrypto")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@schema("backcrypto")
}

model PasswordResetToken {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@schema("backcrypto")
}

model UserCoinWallet {
  id        String            @id @default(cuid())
  userId    String            @unique
  balance   Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  entries   CoinLedgerEntry[]
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("backcrypto")
}

model CoinLedgerEntry {
  id        String         @id @default(cuid())
  userId    String
  walletId  String
  type      TxType
  source    TxSource
  amount    Int
  refId     String?
  meta      Json?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet    UserCoinWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  credit    WalletCredit?  @relation("EntryCredit")

  @@unique([source, refId])
  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([source, createdAt])
  @@schema("backcrypto")
}

model WalletCredit {
  id        String          @id @default(cuid())
  userId    String
  entryId   String          @unique
  amount    Int
  consumed  Int             @default(0)
  expiresAt DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  entry     CoinLedgerEntry @relation("EntryCredit", fields: [entryId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, createdAt])
  @@schema("backcrypto")
}

model StripeEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([type])
  @@schema("backcrypto")
}

model StripeCheckoutSession {
  id               String         @id @default(cuid())
  userId           String
  status           CheckoutStatus @default(CREATED)
  amountTotalCents Int
  currency         String
  coinsToCredit    Int
  pricingLabel     String
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, completedAt])
  @@index([completedAt])
  @@schema("backcrypto")
}

model PagarMeOrder {
  id               String         @id
  userId           String
  status           CheckoutStatus @default(CREATED)
  amountTotalCents Int
  currency         String         @default("BRL")
  coinsToCredit    Int
  pricingLabel     String
  qrCode           String?
  qrCodeUrl        String?
  pixCopyPaste     String?
  expiresAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, completedAt])
  @@index([completedAt])
  @@index([status])
  @@schema("backcrypto")
}

// Velas (klines) Binance — BTCUSDT 1m; manter 180 dias com expurgo
model BinanceKline {
  symbol                   String // ex.: BTCUSDT
  interval                 String // ex.: 1m
  openTime                 BigInt // abertura (ms UTC)
  open                     Decimal @db.Decimal(32, 8)
  high                     Decimal @db.Decimal(32, 8)
  low                      Decimal @db.Decimal(32, 8)
  close                    Decimal @db.Decimal(32, 8)
  volume                   Decimal @db.Decimal(32, 8)
  closeTime                BigInt
  quoteAssetVolume         Decimal @db.Decimal(32, 8)
  numberOfTrades           Int
  takerBuyBaseAssetVolume  Decimal @db.Decimal(32, 8)
  takerBuyQuoteAssetVolume Decimal @db.Decimal(32, 8)

  @@id([symbol, interval, openTime])
  @@index([symbol, interval, openTime])
  @@index([symbol, interval, openTime(sort: Desc)], map: "BinanceKline_symbol_interval_openTime_desc_idx")
  @@schema("backcrypto")
}

// Cópia idêntica de BinanceKline (mesma estrutura e dados)
model BinanceKlineFast {
  symbol                   String
  interval                 String
  openTime                 BigInt
  open                     Decimal @db.Decimal(32, 8)
  high                     Decimal @db.Decimal(32, 8)
  low                      Decimal @db.Decimal(32, 8)
  close                    Decimal @db.Decimal(32, 8)
  volume                   Decimal @db.Decimal(32, 8)
  closeTime                BigInt
  quoteAssetVolume         Decimal @db.Decimal(32, 8)
  numberOfTrades           Int
  takerBuyBaseAssetVolume  Decimal @db.Decimal(32, 8)
  takerBuyQuoteAssetVolume Decimal @db.Decimal(32, 8)

  @@id([symbol, interval, openTime])
  @@index([symbol, interval, openTime])
  @@index([symbol, interval, openTime(sort: Desc)], map: "BinanceKlineFast_symbol_interval_openTime_desc_idx")
  @@schema("backcrypto")
}

// Cache de klines agregados a partir de BinanceKline 1m. Sem 1m; intervalos até 1D.
// Contém apenas dados com openTime < início do dia atual (UTC). Recriada pelo script binance-kline-cache-refresh.
model BinanceKlineCache {
  symbol                   String
  interval                 String // 3m | 5m | 15m | 30m | 1h | 2h | 4h | 6h | 8h | 12h | 1d
  openTime                 BigInt
  open                     Decimal @db.Decimal(32, 8)
  high                     Decimal @db.Decimal(32, 8)
  low                      Decimal @db.Decimal(32, 8)
  close                    Decimal @db.Decimal(32, 8)
  volume                   Decimal @db.Decimal(32, 8)
  closeTime                BigInt
  quoteAssetVolume         Decimal @db.Decimal(32, 8)
  numberOfTrades           Int
  takerBuyBaseAssetVolume  Decimal @db.Decimal(32, 8)
  takerBuyQuoteAssetVolume Decimal @db.Decimal(32, 8)

  @@id([symbol, interval, openTime])
  @@index([symbol, interval, openTime])
  @@index([symbol, interval, openTime(sort: Desc)], map: "BinanceKlineCache_symbol_interval_openTime_desc_idx")
  @@schema("backcrypto")
}

// Gaps conhecidos (sem dado na Binance): ao validar, estes intervalos são ignorados.
model BinanceKlineGap {
  symbol   String
  interval String // 1m | 1h
  gapFrom  BigInt // openTime do candle anterior ao gap
  gapTo    BigInt // openTime do candle seguinte ao gap

  @@id([symbol, interval, gapFrom, gapTo])
  @@index([symbol, interval])
  @@schema("backcrypto")
}
