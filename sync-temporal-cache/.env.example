# Postgres de produção (Neon) — mesmo URL que URL_PROD na app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Modo contínuo (PM2): corrida no restart + 1×/dia à meia-noite local (TZ do Node).
# Corrida imediata: npm run once

# Health HTTP (modo contínuo). Default 3047. 0 desliga.
# TEMPORAL_CACHE_HTTP_PORT=3047

# Timeout máximo de um ciclo (ms). Default 2700000 (45 min).
# TEMPORAL_CACHE_CYCLE_MAX_MS=2700000

# Ciclo preso (busy) antes de exit 1 → PM2 reinicia. Default 3000000 (50 min).
# TEMPORAL_CACHE_BUSY_STUCK_MS=3000000

# Sem progresso (stall watchdog). Default 900000 (15 min). 0 desliga.
# VPS_STALL_EXIT_MS=900000
