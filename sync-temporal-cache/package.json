{
  "name": "sevencoins-sync-temporal-cache",
  "private": true,
  "version": "0.0.1",
  "description": "Refresh BinanceKlineCache (gráficos temporais) em prod — mesma lógica do Debug → Refresh cache.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "once": "node --import tsx src/index.ts --once"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^6.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
