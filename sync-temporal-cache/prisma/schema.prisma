// Subconjunto alinhado ao prisma da app — tabelas do refresh BinanceKlineCache.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["backcrypto"]
}

model BinanceKline {
  corretora                String
  symbol                   String
  interval                 String
  openTime                 BigInt
  open                     Decimal  @db.Decimal(32, 8)
  high                     Decimal  @db.Decimal(32, 8)
  low                      Decimal  @db.Decimal(32, 8)
  close                    Decimal  @db.Decimal(32, 8)
  volume                   Decimal  @db.Decimal(32, 8)
  closeTime                BigInt
  quoteAssetVolume         Decimal  @db.Decimal(32, 8)
  numberOfTrades           Int
  takerBuyBaseAssetVolume  Decimal  @db.Decimal(32, 8)
  takerBuyQuoteAssetVolume Decimal  @db.Decimal(32, 8)

  @@id([corretora, symbol, interval, openTime])
  @@index([corretora, symbol, interval, openTime])
  @@index([corretora, symbol, interval, openTime(sort: Desc)], map: "BinanceKline_symbol_interval_openTime_desc_idx")
  @@schema("backcrypto")
}

model BinanceKlineFast {
  corretora                String
  symbol                   String
  interval                 String
  openTime                 BigInt
  open                     Decimal  @db.Decimal(32, 8)
  high                     Decimal  @db.Decimal(32, 8)
  low                      Decimal  @db.Decimal(32, 8)
  close                    Decimal  @db.Decimal(32, 8)
  volume                   Decimal  @db.Decimal(32, 8)
  closeTime                BigInt
  quoteAssetVolume         Decimal  @db.Decimal(32, 8)
  numberOfTrades           Int
  takerBuyBaseAssetVolume  Decimal  @db.Decimal(32, 8)
  takerBuyQuoteAssetVolume Decimal  @db.Decimal(32, 8)

  @@id([corretora, symbol, interval, openTime])
  @@index([corretora, symbol, interval, openTime])
  @@index([corretora, symbol, interval, openTime(sort: Desc)], map: "BinanceKlineFast_symbol_interval_openTime_desc_idx")
  @@schema("backcrypto")
}

model BinanceKlineMonth {
  corretora                String
  symbol                   String
  interval                 String
  openTime                 BigInt
  open                     Decimal  @db.Decimal(32, 8)
  high                     Decimal  @db.Decimal(32, 8)
  low                      Decimal  @db.Decimal(32, 8)
  close                    Decimal  @db.Decimal(32, 8)
  volume                   Decimal  @db.Decimal(32, 8)
  closeTime                BigInt
  quoteAssetVolume         Decimal  @db.Decimal(32, 8)
  numberOfTrades           Int
  takerBuyBaseAssetVolume  Decimal  @db.Decimal(32, 8)
  takerBuyQuoteAssetVolume Decimal  @db.Decimal(32, 8)

  @@id([corretora, symbol, interval, openTime])
  @@index([corretora, symbol, interval, openTime])
  @@index([corretora, symbol, interval, openTime(sort: Desc)], map: "BinanceKlineMonth_symbol_interval_openTime_desc_idx")
  @@schema("backcrypto")
}

model KlineSymbol {
  symbol         String  @id
  ativo          Boolean @default(true)
  requiredDays1m Int?
  requiredDays5m Int?
  requiredDays1h Int?

  @@schema("backcrypto")
}
